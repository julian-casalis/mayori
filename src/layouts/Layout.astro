---
/*
  Layout.astro
  --------------------------------------------------
  Este es el "molde" que envuelve a TODAS las páginas
  del sitio (index, productos, categoría, producto, etc.).

  Acá se define:
  - El <head> con metadatos, fuentes y estilos globales
  - El Navbar (arriba) y el Footer (abajo), que se repiten
    en todas las páginas
  - El FloatingWhatsApp: botón flotante de contacto directo

  El sitio funciona como catálogo informativo (sin carrito
  de compras), así que acá no se carga ningún script de
  carrito: solo el contenido de cada página.

  El contenido específico de cada página se inyecta en
  <slot />.
  --------------------------------------------------
*/
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import FloatingWhatsApp from '../components/FloatingWhatsApp.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'La Distribuidora — Golosinas, bebidas, librería y más',
  description = 'Catálogo online de golosinas, galletitas, bebidas, jugos, librería, chocolates y snacks. Consultá por WhatsApp.',
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="description" content={description} />
    <title>{title}</title>

    <!-- Tipografía Inter / Poppins (limpias, muy legibles) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Poppins:wght@600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <Navbar />

    <main>
      <slot />
    </main>

    <Footer />

    <!-- Botón flotante de WhatsApp -->
    <FloatingWhatsApp />
  </body>
</html>
