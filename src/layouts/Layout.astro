---
/*
  Layout.astro
  --------------------------------------------------
  Este es el "molde" que envuelve a TODAS las páginas
  del sitio (index, productos, carrito, etc.).

  Acá se define:
  - El <head> con metadatos, fuentes y estilos globales
  - El Navbar (arriba) y el Footer (abajo), que se repiten
    en todas las páginas
  - El CartSidebar: el panel lateral del carrito, que vive
    fuera del <slot /> porque debe poder abrirse desde
    cualquier página (se controla con JS, no con navegación)
  - El FloatingWhatsApp: botón flotante de contacto directo
  - La carga de cart.js, que expone window.Carrito a toda
    la app para que cualquier componente pueda usar el carrito

  El contenido específico de cada página se inyecta en
  <slot />.
  --------------------------------------------------
*/
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import CartSidebar from '../components/CartSidebar.astro';
import FloatingWhatsApp from '../components/FloatingWhatsApp.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'La Distribuidora — Golosinas, bebidas, librería y más',
  description = 'Catálogo online de golosinas, galletitas, bebidas, jugos, librería, chocolates y snacks. Armá tu pedido y lo coordinamos por WhatsApp.',
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="description" content={description} />
    <title>{title}</title>

    <!-- Tipografía Inter / Poppins (limpias, muy legibles) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Poppins:wght@600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <Navbar />

    <main>
      <slot />
    </main>

    <Footer />

    <!-- Panel lateral del carrito: disponible en toda la app -->
    <CartSidebar />

    <!-- Botón flotante de WhatsApp -->
    <FloatingWhatsApp />

    <!--
      cart.js se carga UNA sola vez acá en el layout, por eso
      window.Carrito está disponible en todas las páginas sin
      tener que volver a importarlo.
    -->
    <script src="/scripts/cart.js" is:inline></script>
  </body>
</html>
