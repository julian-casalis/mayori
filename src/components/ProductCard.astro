---
const { producto } = Astro.props;
---

<div class="card">
  <img src={producto.imagen} alt={producto.nombre} />

  <h3>{producto.nombre}</h3>

  <p>$ {producto.precio}</p>

  <button
    class="agregar"
    data-id={producto.id}
    data-nombre={producto.nombre}
    data-precio={producto.precio}
  >
    Agregar
  </button>
</div>
